{
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)"
    ]
  },
  "extraKnownMarketplaces": {
    "agentic-sdlc": {
      "source": {
        "source": "github",
        "repo": "cdowin/agentic-sdlc",
        "ref": "v4.12.0"
      }
    }
  },
  "enabledPlugins": {
    "agentic-sdlc@agentic-sdlc": true,
    "superpowers@claude-plugins-official": false,
    "shipyard@shipyard": false,
    "atlassian@claude-plugins-official": false,
    "imessage@claude-plugins-official": false,
    "github@claude-plugins-official": false
  }
}
