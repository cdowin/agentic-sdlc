__pycache__/
*.pyc
# The environments `uv run` installs this tree into: .venv on the floor, and one
# per interpreter under `make matrix`.
.venv*/

# Gate transcripts: one slot per gate, cleared per run, bounded by construction.
.gate-reports/

# Per-worktree scope marker tools/dev/agent-worktree.sh plants for the hooks to read.
.agent-scope

# Agent worktrees, created by tools/dev/agent-worktree.sh; each is its own checkout.
.claude/worktrees/

# The consumer deny-list the shipped-file guards sweep for — maintainer
# configuration, never committed: this tree is public and the names are
# the maintainer's own repositories. See tests/support/consumers.py.
.consumer-names

# The harness's per-user hook registration. `install-hooks` emits ABSOLUTE
# script paths, and this tree is public — a committed machine path names one
# person's filesystem. The block goes here, with GDK_LEDGER_ROOT exported by
# any session rooted outside this checkout. tests/test_install.py grades both
# halves: what is registered, and that nothing absolute is committed.
.claude/settings.local.json

# agentic-sdlc: what a run on THIS machine cost (gate, test, verify rows) — never committed, so a commit's own hook leaves the tree clean
pm/roadmap/ledger.local.jsonl
