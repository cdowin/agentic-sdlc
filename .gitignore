__pycache__/
*.pyc
# The environments `uv run` installs this tree into: .venv on the floor, and one
# per interpreter under `make matrix`.
.venv*/

# Gate transcripts: one slot per gate, cleared per run, bounded by construction.
.gate-reports/

# Per-worktree scope marker tools/dev/agent-worktree.sh plants for the hooks to read.
.agent-scope

# Agent worktrees, created by tools/dev/agent-worktree.sh; each is its own checkout.
.claude/worktrees/

# The consumer deny-list the shipped-file guards sweep for — maintainer
# configuration, never committed: this tree is public and the names are
# the maintainer's own repositories. See tests/support/consumers.py.
.consumer-names
