# Makefile.tiers — agentic-sdlc's own test tiers, on Makefile.devkit's seam.
#
# This file is what a language kit writes for a consumer; here the "kit" is
# pytest and the consumer is the package itself. It DEFINES the tier targets,
# DECLARES which compositions they join, and carries its own .PHONY.
#
# THE LADDER (decision D10). `unit` is the inner loop: no subprocess, one
# process, seconds. `integration` is everything that spawns — a real repo, a
# real make, an installed hook corpus. `test` is both and runs at milestone close.
# Feature close uses check + unit. `matrix` is every claimed interpreter past the floor, at the
# milestone — so the milestone runs each suite once.
# The tier is the `shell` mark, DERIVED by tests/conftest.py from what a
# module's source reaches — never a list here.
GDK_PRECOMMIT_TIERS := unit
# `test` is the one run of the whole suite; `matrix` adds every other
# interpreter. Cost stays visible in `pm ledger report`, never a gate.
GDK_MILESTONE_TIERS := test matrix

# The package is stdlib-only at RUNTIME (hard rule 1). pytest and xdist are the
# `dev` dependency group in pyproject.toml, and `uv run` syncs them into the
# same environment the package is installed into. 3.11 is the declared floor
# and where the fast loop runs; the matrix is every interpreter it claims.
PY_FLOOR  ?= 3.11
PY_MATRIX ?= 3.11 3.12 3.13 3.14
# `uv run` takes the first interpreter it finds that `requires-python` allows,
# and on a CI runner that need not be the floor. The matrix no longer runs the
# floor, so `test` must: UV_PYTHON is exported for every recipe here, the
# project's .venv included. An environment that already sets UV_PYTHON (a CI
# matrix leg) keeps its own.
UV_PYTHON ?= $(PY_FLOOR)
export UV_PYTHON
# `auto` is the machine's core count; `loadgroup` keeps the tests that spawn
# `make` against THIS repo on one worker so they serialise against each other
# and nothing else.
PYTEST_N  ?= -n auto --dist loadgroup
PYTEST    ?= $(UV) run -q python -m pytest -q

# The one-line summary and the census, read off the same pytest summary line
# so the number in the ledger row and the number a human sees cannot disagree.
SUM_PYTEST    := grep -aoE '[0-9]+ (passed|failed)[^|]*' "$$log" | tail -1
CENSUS_PYTEST := grep -aoE '[0-9]+ passed' "$$log" | tail -1 | grep -oE '[0-9]+'

.PHONY: unit integration test fuzz matrix

unit: export GDK_TEST_TIER = unit
unit: ## the inner loop: no subprocess, every core, seconds
	$(call gdk_gate,unit,UNIT,$(SUM_PYTEST),$(PYTEST) $(PYTEST_N) -m "not shell",$(CENSUS_PYTEST))

integration: export GDK_TEST_TIER = integration
integration: ## everything that spawns — a real repo, make, a hook corpus
	$(call gdk_gate,integration,INTEGRATION,$(SUM_PYTEST),$(PYTEST) $(PYTEST_N) -m shell,$(CENSUS_PYTEST))

test: export GDK_TEST_TIER = test
test: ## both tiers on the $(PY_FLOOR) floor — what the milestone runs
	$(call gdk_gate,test,TEST,$(SUM_PYTEST),$(PYTEST) $(PYTEST_N),$(CENSUS_PYTEST))

fuzz: ## the seeded differential + replay harnesses alone (`test` runs them too)
	$(call gdk_gate,fuzz,FUZZ,$(SUM_PYTEST),$(PYTEST) -m fuzz)

# The interpreters PAST the floor, in parallel, each on the no-spawn tier. The
# floor is not run here: `test` already ran the whole suite on it, and a second
# pass on the same interpreter was 85 of a CI run's 240 seconds. A spawn is not
# something a Python version changes, so every other interpreter runs
# `-m "not shell"`. Each one gets its own environment (`.venv-<version>`, kept
# between runs) so the project's own .venv is never rebuilt under the matrix,
# and its own transcript (`matrix-<version>.log`); `matrix.log` holds all of
# them, in PY_MATRIX order. A matrix with nothing past the floor, or a roster
# that is not a list of versions, is refused BEFORE the first interpreter: a
# gate that ran nothing must not print PASS. CI runs the same legs as jobs of
# their own (verify.yml's `python` job), so its `make milestone` skips this
# target through GDK_MILESTONE_SKIP.
matrix: ## every PY_MATRIX interpreter past PY_FLOOR, in parallel, `-m "not shell"`; `test` runs the floor
	@set -o pipefail; set -f; . $(GDK_GATE_LIB); \
	log="$$(gdk_gate_log matrix)"; fail=''; legs=''; bad=''; \
	case '$(PY_FLOOR)' in ''|*[!0-9.]*) bad=y ;; esac; \
	for v in $(PY_MATRIX); do \
		case "$$v" in *[!0-9.]*) bad=y ;; esac; \
		[ "$$v" = '$(PY_FLOOR)' ] && continue; \
		case " $$legs " in *" $$v "*) continue ;; esac; \
		legs="$${legs:+$$legs }$$v"; \
	done; \
	if [ -n "$$bad" ] || [ -z "$$legs" ]; then \
		echo 'PY_FLOOR "$(PY_FLOOR)" / PY_MATRIX "$(PY_MATRIX)"' >> "$$log"; \
		gdk_gate_verdict MATRIX 'REFUSED: PY_FLOOR "$(PY_FLOOR)" and PY_MATRIX "$(PY_MATRIX)" leave no interpreter past the floor to run — PY_FLOOR is one version, PY_MATRIX a list of them' "$$log"; \
		exit 2; \
	fi; \
	trap 'kill $$(jobs -p) 2>/dev/null' INT TERM; \
	for v in $$legs; do \
		leg="$${log%.log}-$$v.log"; \
		( env UV_PROJECT_ENVIRONMENT=".venv-$$v" \
			$(UV) run -q --python "$$v" python -m pytest -q $(PYTEST_N) -m 'not shell' \
			> "$$leg" 2>&1; echo "$$?" > "$$leg.rc" ) & \
	done; \
	wait; \
	for v in $$legs; do \
		leg="$${log%.log}-$$v.log"; \
		echo "=== python $$v (-m \"not shell\") ===" >> "$$log"; \
		[ "$$VERBOSE" = "" ] || echo "=== python $$v (-m \"not shell\") ==="; \
		gdk_gate_capture "$$log" -- bash -c 'cat -- "$$1"; exit "$$(cat -- "$$1.rc" 2>/dev/null || echo 1)"' _ "$$leg"; \
		rm -f -- "$$leg.rc"; \
		[ "$$GDK_GATE_EXIT" -eq 0 ] || fail="$$fail $$v"; \
	done; \
	if [ -n "$$fail" ]; then \
		grep -aE '$(GDK_GATE_FAIL_RE)' "$$log" | head -$(GDK_GATE_FAIL_LINES) || true; \
		gdk_gate_verdict MATRIX "FAIL on$$fail" "$$log"; \
		exit 1; \
	fi; \
	gdk_gate_verdict MATRIX "PASS on $$legs (the floor $(PY_FLOOR) runs in \`test\`)" "$$log"
