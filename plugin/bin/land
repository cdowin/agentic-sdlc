#!/bin/sh
# land [--branch <name>] [--part-of <N>|#N|owner/repo#N]... [--closes|--part-of <branch>] <issue-branch>...
# land [--part-of <N>]... --queue <file>
# --wave is a deprecated alias of --branch (v4 name); it prints a deprecation line and goes in v6.
# Land finished issue branches in 1 PR, then clean up. Run it from a clone whose remote `origin`
# holds the branches. Steps:
#   1. Add a worktree on the landing branch at origin/<base>, and merge each origin/<issue-branch>
#      into it (merge commits, in the order given). When origin already holds the landing branch (a
#      run that stopped after its push), start from it and merge origin/<base> into it first.
#   2. A conflict only in files that match LAND_GENERATED keeps our side (the landing branch so far),
#      then LAND_REGEN adds the inputs of the incoming branch.
#      Any other conflict stops the run: it prints the files, removes the worktree and the landing
#      branch, pushes nothing and exits 1. Merge the base into that issue branch and run it again.
#   3. Run LAND_REGEN and commit what it changes, then run LAND_CHECK. A red check
#      stops the run the same way.
#   4. Push the landing branch and open 1 PR (or reuse the open PR of the landing branch). The body has
#      1 line for each issue number a branch starts with: "Part of #N" when N is a listed parent
#      (--part-of N, LAND_PARENTS) or the branch follows --part-of, else "Closes #N";
#      --closes <branch> writes "Closes #N" for a parent's last slice. Enable auto-merge and run
#      wait-ci --merge: it merges the PR by hand when CI is green and auto-merge did not fire.
#   5. A PR left BEHIND: merge origin/<base> into the landing branch, run steps 2 and 3 again, push and
#      wait again (3 rounds at most). With LAND_REGEN set, wait-ci leaves this to land
#      (WAIT_CI_UPDATE=0), so the generated files are regenerated after the base merge.
#      A red check or any other end state: print the failing checks, keep the PR and origin's
#      landing branch, delete nothing and exit 1. Fix the issue branch and run it again.
#   6. When the PR merged: delete each issue branch and the landing branch, on origin and here, that
#      the base now contains, with its worktree; and each origin branch that matches
#      LAND_MIRRORS and that the base contains.
# --queue <file>: each line is 1 landing, the arguments of 1 run ("[--branch <name>] <branch>...";
# blank and # lines are skipped). Landings go in order, 1 PR in CI at a time. The first landing that
# stops ends the queue with exit 1. Each landed line goes into <file>.landed, and a rerun skips
# those lines, so it resumes at the first line not landed.
# Never chain landings with `pgrep -f` waiters: each waiter's command line holds the text the others
# search for, so none ever starts. Land every report that is in together, in 1 run; that run is the queue.
# While the PR waits on CI, a progress line prints each minute (LAND_BEAT seconds). A merge that
# reads MERGE_FAILED with no red check gets LAND_SETTLE seconds (default 120) to read MERGED; the
# cleanup runs only after a MERGED read. After it, an executable `review-due` beside this script runs as
# `review-due <owner/repo> <base>` and its output prints.
# The run moves to the repo's main checkout first, so removing the issue worktree it started in is safe.
# A cleanup step that fails is reported, the others still run, and the exit is 1.
# Settings (env vars); each hook runs with sh -c in the landing worktree:
#   LAND_BASE       the base branch (default main)
#   LAND_REGEN      the regenerate command (default none)
#   LAND_GENERATED  space-separated case patterns of generated files (used only with REGEN);
#                        matched as written, never expanded as file globs
#   LAND_CHECK      the quick checks (default none)
#   LAND_PARENTS    space-separated parent issue numbers: their branches write "Part of #N"
#   LAND_MIRRORS    space-separated case patterns of session mirror branches (default claude/*)
#   LAND_WORKDIR    the directory that holds the landing worktree (default: beside the main checkout,
#                        as <checkout>-land; under $HOME for a gate that runs in a container)
#   LAND_REPO       owner/repo for gh (default: from the URL of origin)
# Each LAND_* setting falls back to its v4 name WAVE_LAND_* (with a deprecation line); the fallback goes in v6.
# Exit 0 when the PR merged and the cleanup ran, 1 when it stopped, 2 on bad arguments.
# shellcheck disable=SC2086,SC2254,SC2015 # word lists and case patterns; A && echo || fail cannot misfire
set -fu # -f: a pattern such as dist/** is never expanded to file names
usage='usage: land [--branch <name>] [--part-of <N>]... [--closes|--part-of <branch>] <issue-branch>... | [--part-of <N>]... --queue <file>'
bad() { echo "$usage" >&2; exit 2; }
# Exported, so a queue run's child land reads LAND_* and does not repeat the deprecation line.
for v in BASE REGEN GENERATED CHECK PARENTS MIRRORS WORKDIR REPO BEAT SETTLE; do
  eval "old=\${WAVE_LAND_$v+x} new=\${LAND_$v+x}"
  [ -n "$old" ] && [ -z "$new" ] || continue
  echo "land: WAVE_LAND_$v is deprecated; use LAND_$v" >&2
  eval "LAND_$v=\$WAVE_LAND_$v; export LAND_$v"
done
lbranch='' queue='' parents=${LAND_PARENTS:-} partb=' ' closeb=' ' branches='' pre='' xref=''
while [ "$#" -gt 0 ]; do
  case $1 in
    --branch | --wave | --queue | --part-of | --closes) [ "$#" -ge 2 ] && [ -n "$2" ] || bad ;;
  esac
  case $1 in
    --branch) lbranch=$2; shift 2 ;;
    --wave) echo "land: --wave is deprecated; use --branch" >&2; lbranch=$2; shift 2 ;;
    --queue) queue=$2; shift 2 ;;
    --part-of)
      case $2 in
        */*'#'[0-9]*) xref="$xref $2"; pre="$pre --part-of $2" ;;
        '#'[0-9]*) parents="$parents ${2#?}" pre="$pre --part-of ${2#?}" ;;
        *[!0-9]*) partb="$partb$2 " branches="$branches $2" ;;
        *) parents="$parents $2" pre="$pre --part-of $2" ;;
      esac
      shift 2 ;;
    --closes) closeb="$closeb$2 " branches="$branches $2"; shift 2 ;;
    -*) bad ;;
    *) branches="$branches $1"; shift ;;
  esac
done
bin=$(cd "$(dirname "$0")" && pwd)

if [ -n "$queue" ]; then
  [ -z "$branches$lbranch" ] || bad
  [ -f "$queue" ] || { echo "land: no queue file $queue" >&2; exit 2; }
  state=$queue.landed
  touch "$state" || exit 2
  i=0 landed=0
  while IFS= read -r line <&3; do
    i=$((i + 1))
    case $line in '' | '#'*) continue ;; esac
    if grep -qxF -- "$line" "$state"; then echo "land: queue line $i already landed: $line"; continue; fi
    echo "land: queue line $i: $line"
    sh "$bin/land" $pre $line 3<&- || { echo "land: queue stopped at line $i ($line); fix it and run the queue again to resume there" >&2; exit 1; }
    printf '%s\n' "$line" >> "$state"
    landed=$((landed + 1))
  done 3< "$queue"
  echo "land: queue done, $landed line(s) landed"
  exit 0
fi

set -- $branches
[ "$#" -gt 0 ] || bad
base=${LAND_BASE:-main} regen=${LAND_REGEN:-} check=${LAND_CHECK:-}
generated=${LAND_GENERATED:-} mirrors=${LAND_MIRRORS:-claude/*}
[ -n "$regen" ] || generated=
git rev-parse --git-dir > /dev/null 2>&1 || { echo "land: not in a git repo" >&2; exit 2; }
# Work from the main checkout (or the bare repo), which survives the removal of any worktree.
home=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
cd "$home" || exit 2
issue() { printf '%s\n' "${1##*/}" | sed -n 's/^\([0-9][0-9]*\).*/\1/p'; }
nums='-' cn=' ' pn=' '
for b in "$@"; do
  n=$(issue "$b")
  [ -n "$n" ] || continue
  case $nums in *"-$n-"*) ;; *) nums="$nums$n-" ;; esac
  kind=c
  case " $parents " in *" $n "*) kind=p ;; esac
  case $partb in *" $b "*) kind=p ;; esac
  case $closeb in *" $b "*) kind=c ;; esac
  if [ "$kind" = c ]; then cn="$cn$n "; else pn="$pn$n "; fi
done
links=''
for n in $cn; do case $links in *"#$n
"*) ;; *) links="${links}Closes #$n
" ;; esac; done
for n in $pn; do case "$cn$links" in *" $n "* | *"#$n
"*) ;; *) links="${links}Part of #$n
" ;; esac; done
for r in $xref; do links="${links}Part of $r
"; done
nums=${nums%-}
[ -n "$lbranch" ] || lbranch=land${nums:--$(date -u +%Y%m%d%H%M%S)}
repo=${LAND_REPO:-$(git remote get-url origin | sed -e 's#/*$##' -e 's#\.git$##' -e 's#.*[:/]\([^/:]*/[^/]*\)$#\1#')}

case " $base $* " in *" $lbranch "*) echo "land: the landing branch $lbranch is the base or an issue branch" >&2; exit 2 ;; esac
wt_of() { git worktree list --porcelain | awk -v r="refs/heads/$1" '/^worktree /{w=substr($0,10)} $0=="branch " r{print w}'; }
resume=
git ls-remote --exit-code -q origin "refs/heads/$lbranch" > /dev/null 2>&1 && resume=$lbranch
git fetch -q origin "$base" "$@" $resume || { echo "land: cannot fetch $base $* $resume" >&2; exit 1; }
if [ -n "${LAND_WORKDIR:-}" ]; then park=''; dir=$LAND_WORKDIR/$lbranch; else park=${home%/}-land; dir=$park/$lbranch; fi
mkdir -p "$(dirname "$dir")" || exit 1
git worktree add -q -b "$lbranch" "$dir" "origin/${resume:-$base}" || exit 1
g() { git -C "$dir" "$@"; }
stop() { # <reason>: drop the worktree and the local landing branch
  echo "land: $1" >&2
  g merge --abort > /dev/null 2>&1
  git worktree remove --force "$dir" && git branch -q -D "$lbranch"
  [ -z "$park" ] || rmdir "$park" 2> /dev/null
  exit 1
}
run() { (cd "$dir" && sh -c "$1"); }
generated() { for p in $generated; do case $1 in $p) return 0 ;; esac; done; return 1; }
merge_in() { # <ref> <name>
  g merge -q --no-ff --no-edit -m "Merge $2 into $lbranch" "$1" > /dev/null 2>&1 && return 0
  files=$(g diff --name-only --diff-filter=U)
  [ -n "$files" ] || stop "merge of $2 failed with no conflicted file"
  hand=
  for f in $files; do generated "$f" || hand="$hand $f"; done
  [ -z "$hand" ] || stop "merge of $2 conflicts in:$hand"
  for f in $files; do g checkout -q --ours -- "$f"; done
  run "$regen" || stop "$regen failed after the merge of $2"
  if ! { g add -A && g commit -q --no-edit; }; then stop "cannot commit the merge of $2"; fi
}
regen_check() { # <what was merged>
  if [ -n "$regen" ]; then
    run "$regen" || stop "$regen failed"
    [ -z "$(g status --porcelain)" ] || { g add -A && g commit -q -m "Regenerate after merging $1"; } || stop "cannot commit the regenerate step"
  fi
  [ -z "$check" ] || run "$check" || stop "$check failed"
}

[ -z "$resume" ] || merge_in "origin/$base" "$base"
for b in "$@"; do merge_in "origin/$b" "$b"; done
regen_check "$*"
g push -q origin "$lbranch" || stop "cannot push $lbranch"
n=
[ -z "$resume" ] || n=$(gh api "repos/$repo/pulls?head=${repo%%/*}:$lbranch&state=open" -q '.[0].number // empty' 2> /dev/null)
if [ -n "$n" ]; then echo "land: pushed $lbranch to the open PR $repo#$n"
else
  n=$(gh api "repos/$repo/pulls" -f title="Land $*" -f head="$lbranch" -f base="$base" \
    -f body="${links}Lands $* with land." -q .number) || stop "pushed $lbranch; cannot open the PR"
  echo "land: opened $repo#$n"
fi
gh pr merge "$n" -R "$repo" --auto --merge > /dev/null 2>&1 || echo "land: auto-merge is off for $repo#$n; wait-ci merges it when green"
[ -z "$regen" ] || export WAIT_CI_UPDATE=0
rounds=0 beat=${LAND_BEAT:-60} outf=$(mktemp)
trap 'rm -f "$outf"' EXIT
waited() { # run wait-ci, print a progress line each $beat seconds until it ends
  sh "$bin/wait-ci" --merge "$repo#$n" > "$outf" 2>&1 < /dev/null &
  pid=$! s=0 t=0
  while kill -0 "$pid" 2> /dev/null; do
    sleep 1; s=$((s + 1))
    [ "$s" -lt "$beat" ] || { t=$((t + s)) s=0; echo "land: still waiting on $repo#$n (${t}s)"; }
  done
  wait "$pid"; out=$(cat "$outf")
}
while :; do
  waited
  echo "$out"
  case $out in *": MERGED"*) break ;; esac
  st=$(gh pr view "$n" -R "$repo" --json state -q .state 2> /dev/null)
  [ "$st" = MERGED ] && { echo "land: $repo#$n merged (auto-merge)"; break; }
  case $out in
    *": OPEN BEHIND"*)
      rounds=$((rounds + 1))
      [ "$rounds" -le 3 ] || stop "$repo#$n is still BEHIND after 3 merges of $base; nothing deleted"
      git fetch -q origin "$base" || stop "cannot fetch $base"
      merge_in "origin/$base" "$base"
      regen_check "$base"
      g push -q origin "$lbranch" || stop "cannot push $lbranch"
      echo "land: merged $base into $lbranch; waiting on $repo#$n again"
      continue ;;
  esac
  case $out in
    *": OPEN MERGE_FAILED"*) # the merge may still land (auto-merge): read the state a while, merged or not
      left=${LAND_SETTLE:-120}
      while [ "$left" -gt 0 ] && [ "$st" != MERGED ]; do
        sleep 5; left=$((left - 5))
        st=$(gh pr view "$n" -R "$repo" --json state -q .state 2> /dev/null)
      done
      [ "$st" = MERGED ] && { echo "land: $repo#$n merged after MERGE_FAILED"; break; } ;;
  esac
  red=$(gh pr view "$n" -R "$repo" --json statusCheckRollup -q '[.statusCheckRollup // [] | group_by(.name // .context)[] | max_by(.startedAt // "")
    | select((.conclusion // .state // "") | test("FAILURE|ERROR|CANCELLED|TIMED_OUT|ACTION_REQUIRED")) | "\(.name // .context) \(.conclusion // .state)"] | join(", ")' 2> /dev/null)
  stop "$repo#$n did not merge${red:+; red: $red}; the PR stays open, nothing deleted"
done

rc=0
cfail() { echo "land: cleanup failed: $1" >&2; rc=1; }
git fetch -q --prune origin || cfail "fetch --prune"
landed() { git merge-base --is-ancestor "$1" "origin/$base" 2> /dev/null; }
for b in "$@" "$lbranch"; do
  wt=$(wt_of "$b")
  if [ -n "$wt" ] && landed "$b"; then
    git worktree remove --force "$wt" && echo "land: removed worktree $wt" || cfail "worktree $wt"
  fi
  if landed "refs/heads/$b"; then git branch -q -D "$b" && echo "land: deleted branch $b" || cfail "branch $b"; fi
  if landed "refs/remotes/origin/$b"; then git push -q origin --delete "$b" && echo "land: deleted origin/$b" || cfail "origin/$b"; fi
done
for b in $(git for-each-ref --format='%(refname:lstrip=3)' refs/remotes/origin); do
  for p in $mirrors; do
    case $b in $base | HEAD) ;; $p)
      landed "refs/remotes/origin/$b" && { git push -q origin --delete "$b" && echo "land: deleted mirror origin/$b" || cfail "mirror origin/$b"; } ;;
    esac
  done
done
[ -z "$park" ] || rmdir "$park" 2> /dev/null
git worktree prune
[ ! -x "$bin/review-due" ] || "$bin/review-due" "$repo" "$base"
exit $rc
