#!/bin/sh
# wave-land [--wave <name>] [--part-of <N>]... [--closes|--part-of <branch>] <issue-branch>...
# wave-land [--part-of <N>]... --queue <file>
# Land finished issue branches in 1 PR, then clean up. Run it from a clone whose remote `origin`
# holds the branches. Steps:
#   1. Add a worktree on the wave branch at origin/<base>, and merge each origin/<issue-branch>
#      into it (merge commits, in the order given). When origin already holds the wave branch (a
#      run that stopped after its push), start from it and merge origin/<base> into it first.
#   2. A conflict only in files that match WAVE_LAND_GENERATED keeps our side (the wave branch so far),
#      then WAVE_LAND_REGEN adds the inputs of the incoming branch.
#      Any other conflict stops the run: it prints the files, removes the worktree and the wave
#      branch, pushes nothing and exits 1. Merge the base into that issue branch and run it again.
#   3. Run WAVE_LAND_REGEN and commit what it changes, then run WAVE_LAND_CHECK. A red check
#      stops the run the same way.
#   4. Push the wave branch and open 1 PR (or reuse the open PR of the wave branch). The body has
#      1 line for each issue number a branch starts with: "Part of #N" when N is a listed parent
#      (--part-of N, WAVE_LAND_PARENTS) or the branch follows --part-of, else "Closes #N";
#      --closes <branch> writes "Closes #N" for a parent's last slice. Enable auto-merge and run
#      wait-ci --merge: it merges the PR by hand when CI is green and auto-merge did not fire.
#   5. A PR left BEHIND: merge origin/<base> into the wave branch, run steps 2 and 3 again, push and
#      wait again (3 rounds at most). With WAVE_LAND_REGEN set, wait-ci leaves this to wave-land
#      (WAIT_CI_UPDATE=0), so the generated files are regenerated after the base merge.
#      A red check or any other end state: print the failing checks, keep the PR and origin's
#      wave branch, delete nothing and exit 1. Fix the issue branch and run it again.
#   6. When the PR merged: delete each issue branch and the wave branch, on origin and here, that
#      the base now contains, with its worktree; and each origin branch that matches
#      WAVE_LAND_MIRRORS and that the base contains.
# --queue <file>: each line is 1 wave, the arguments of 1 run ("[--wave <name>] <branch>...";
# blank and # lines are skipped). Waves land in order, 1 PR in CI at a time. The first wave that
# stops ends the queue with exit 1. Each landed line goes into <file>.landed, and a rerun skips
# those lines, so it resumes at the first wave not landed.
# Settings (env vars); each hook runs with sh -c in the wave worktree:
#   WAVE_LAND_BASE       the base branch (default main)
#   WAVE_LAND_REGEN      the regenerate command (default none)
#   WAVE_LAND_GENERATED  space-separated case patterns of generated files (used only with REGEN)
#   WAVE_LAND_CHECK      the quick checks (default none)
#   WAVE_LAND_PARENTS    space-separated parent issue numbers: their branches write "Part of #N"
#   WAVE_LAND_MIRRORS    space-separated case patterns of session mirror branches (default claude/*)
#   WAVE_LAND_REPO       owner/repo for gh (default: from the URL of origin)
# Exit 0 when the PR merged and the cleanup ran, 1 when it stopped, 2 on bad arguments.
# shellcheck disable=SC2086,SC2254 # the pattern lists split into words and match as case patterns
set -u
usage='usage: wave-land [--wave <name>] [--part-of <N>]... [--closes|--part-of <branch>] <issue-branch>... | [--part-of <N>]... --queue <file>'
bad() { echo "$usage" >&2; exit 2; }
wave='' queue='' parents=${WAVE_LAND_PARENTS:-} partb=' ' closeb=' ' branches='' pre=''
while [ "$#" -gt 0 ]; do
  case $1 in
    --wave | --queue | --part-of | --closes) [ "$#" -ge 2 ] && [ -n "$2" ] || bad ;;
  esac
  case $1 in
    --wave) wave=$2; shift 2 ;;
    --queue) queue=$2; shift 2 ;;
    --part-of)
      case $2 in
        *[!0-9]*) partb="$partb$2 " branches="$branches $2" ;;
        *) parents="$parents $2" pre="$pre --part-of $2" ;;
      esac
      shift 2 ;;
    --closes) closeb="$closeb$2 " branches="$branches $2"; shift 2 ;;
    -*) bad ;;
    *) branches="$branches $1"; shift ;;
  esac
done
bin=$(cd "$(dirname "$0")" && pwd)

if [ -n "$queue" ]; then
  [ -z "$branches$wave" ] || bad
  [ -f "$queue" ] || { echo "wave-land: no queue file $queue" >&2; exit 2; }
  state=$queue.landed
  touch "$state" || exit 2
  i=0 landed=0
  while IFS= read -r line <&3; do
    i=$((i + 1))
    case $line in '' | '#'*) continue ;; esac
    if grep -qxF -- "$line" "$state"; then echo "wave-land: queue line $i already landed: $line"; continue; fi
    echo "wave-land: queue line $i: $line"
    sh "$bin/wave-land" $pre $line 3<&- || { echo "wave-land: queue stopped at line $i ($line); fix it and run the queue again to resume there" >&2; exit 1; }
    printf '%s\n' "$line" >> "$state"
    landed=$((landed + 1))
  done 3< "$queue"
  echo "wave-land: queue done, $landed wave(s) landed"
  exit 0
fi

set -- $branches
[ "$#" -gt 0 ] || bad
base=${WAVE_LAND_BASE:-main} regen=${WAVE_LAND_REGEN:-} check=${WAVE_LAND_CHECK:-}
generated=${WAVE_LAND_GENERATED:-} mirrors=${WAVE_LAND_MIRRORS:-claude/*}
[ -n "$regen" ] || generated=
top=$(git rev-parse --show-toplevel 2> /dev/null) || { echo "wave-land: not in a git repo" >&2; exit 2; }
cd "$top" || exit 2
issue() { printf '%s\n' "${1##*/}" | sed -n 's/^\([0-9][0-9]*\).*/\1/p'; }
nums='-' cn=' ' pn=' '
for b in "$@"; do
  n=$(issue "$b")
  [ -n "$n" ] || continue
  case $nums in *"-$n-"*) ;; *) nums="$nums$n-" ;; esac
  kind=c
  case " $parents " in *" $n "*) kind=p ;; esac
  case $partb in *" $b "*) kind=p ;; esac
  case $closeb in *" $b "*) kind=c ;; esac
  if [ "$kind" = c ]; then cn="$cn$n "; else pn="$pn$n "; fi
done
links=''
for n in $cn; do case $links in *"#$n
"*) ;; *) links="${links}Closes #$n
" ;; esac; done
for n in $pn; do case "$cn$links" in *" $n "* | *"#$n
"*) ;; *) links="${links}Part of #$n
" ;; esac; done
nums=${nums%-}
[ -n "$wave" ] || wave=wave${nums:--$(date -u +%Y%m%d%H%M%S)}
repo=${WAVE_LAND_REPO:-$(git remote get-url origin | sed -e 's#/*$##' -e 's#\.git$##' -e 's#.*[:/]\([^/:]*/[^/]*\)$#\1#')}

case " $base $* " in *" $wave "*) echo "wave-land: the wave branch $wave is the base or an issue branch" >&2; exit 2 ;; esac
wt_of() { git worktree list --porcelain | awk -v r="refs/heads/$1" '/^worktree /{w=substr($0,10)} $0=="branch " r{print w}'; }
resume=
git ls-remote --exit-code -q origin "refs/heads/$wave" > /dev/null 2>&1 && resume=$wave
git fetch -q origin "$base" "$@" $resume || { echo "wave-land: cannot fetch $base $* $resume" >&2; exit 1; }
dir=$(mktemp -d)/$wave
git worktree add -q -b "$wave" "$dir" "origin/${resume:-$base}" || exit 1
g() { git -C "$dir" "$@"; }
stop() { # <reason>: drop the worktree and the local wave branch
  echo "wave-land: $1" >&2
  g merge --abort > /dev/null 2>&1
  git worktree remove --force "$dir" && git branch -q -D "$wave"
  rmdir "$(dirname "$dir")" 2> /dev/null
  exit 1
}
run() { (cd "$dir" && sh -c "$1"); }
generated() { for p in $generated; do case $1 in $p) return 0 ;; esac; done; return 1; }
merge_in() { # <ref> <name>
  g merge -q --no-ff --no-edit -m "Merge $2 into $wave" "$1" > /dev/null 2>&1 && return 0
  files=$(g diff --name-only --diff-filter=U)
  [ -n "$files" ] || stop "merge of $2 failed with no conflicted file"
  hand=
  for f in $files; do generated "$f" || hand="$hand $f"; done
  [ -z "$hand" ] || stop "merge of $2 conflicts in:$hand"
  for f in $files; do g checkout -q --ours -- "$f"; done
  run "$regen" || stop "$regen failed after the merge of $2"
  if ! { g add -A && g commit -q --no-edit; }; then stop "cannot commit the merge of $2"; fi
}
regen_check() { # <what was merged>
  if [ -n "$regen" ]; then
    run "$regen" || stop "$regen failed"
    [ -z "$(g status --porcelain)" ] || { g add -A && g commit -q -m "Regenerate after merging $1"; } || stop "cannot commit the regenerate step"
  fi
  [ -z "$check" ] || run "$check" || stop "$check failed"
}

[ -z "$resume" ] || merge_in "origin/$base" "$base"
for b in "$@"; do merge_in "origin/$b" "$b"; done
regen_check "$*"
g push -q origin "$wave" || stop "cannot push $wave"
n=
[ -z "$resume" ] || n=$(gh api "repos/$repo/pulls?head=${repo%%/*}:$wave&state=open" -q '.[0].number // empty' 2> /dev/null)
if [ -n "$n" ]; then echo "wave-land: pushed $wave to the open PR $repo#$n"
else
  n=$(gh api "repos/$repo/pulls" -f title="Land $*" -f head="$wave" -f base="$base" \
    -f body="${links}Lands $* with wave-land." -q .number) || stop "pushed $wave; cannot open the PR"
  echo "wave-land: opened $repo#$n"
fi
gh pr merge "$n" -R "$repo" --auto --merge > /dev/null 2>&1 || echo "wave-land: auto-merge is off for $repo#$n; wait-ci merges it when green"
[ -z "$regen" ] || export WAIT_CI_UPDATE=0
rounds=0
while :; do
  out=$(sh "$bin/wait-ci" --merge "$repo#$n")
  echo "$out"
  case $out in *": MERGED"*) break ;; esac
  st=$(gh pr view "$n" -R "$repo" --json state -q .state 2> /dev/null)
  [ "$st" = MERGED ] && { echo "wave-land: $repo#$n merged (auto-merge)"; break; }
  case $out in
    *": OPEN BEHIND"*)
      rounds=$((rounds + 1))
      [ "$rounds" -le 3 ] || stop "$repo#$n is still BEHIND after 3 merges of $base; nothing deleted"
      git fetch -q origin "$base" || stop "cannot fetch $base"
      merge_in "origin/$base" "$base"
      regen_check "$base"
      g push -q origin "$wave" || stop "cannot push $wave"
      echo "wave-land: merged $base into $wave; waiting on $repo#$n again"
      continue ;;
  esac
  red=$(gh pr view "$n" -R "$repo" --json statusCheckRollup -q '[.statusCheckRollup // [] | group_by(.name // .context)[] | max_by(.startedAt // "")
    | select((.conclusion // .state // "") | test("FAILURE|ERROR|CANCELLED|TIMED_OUT|ACTION_REQUIRED")) | "\(.name // .context) \(.conclusion // .state)"] | join(", ")' 2> /dev/null)
  stop "$repo#$n did not merge${red:+; red: $red}; the PR stays open, nothing deleted"
done

git fetch -q --prune origin
landed() { git merge-base --is-ancestor "$1" "origin/$base" 2> /dev/null; }
for b in "$@" "$wave"; do
  wt=$(wt_of "$b")
  if [ -n "$wt" ] && landed "$b"; then git worktree remove --force "$wt" && echo "wave-land: removed worktree $wt"; fi
  if landed "refs/heads/$b" && git branch -q -D "$b" 2> /dev/null; then echo "wave-land: deleted branch $b"; fi
  if landed "refs/remotes/origin/$b" && git push -q origin --delete "$b"; then echo "wave-land: deleted origin/$b"; fi
done
git for-each-ref --format='%(refname:lstrip=3)' refs/remotes/origin | while read -r b; do
  for p in $mirrors; do
    case $b in $base | HEAD) ;; $p) landed "refs/remotes/origin/$b" && git push -q origin --delete "$b" && echo "wave-land: deleted mirror origin/$b" ;; esac
  done
done
rmdir "$(dirname "$dir")" 2> /dev/null
git worktree prune
exit 0
