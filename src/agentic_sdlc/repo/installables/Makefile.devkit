# Makefile.devkit — the gate FRAMEWORK, and nothing a language kit owns.
#
# DEVKIT-OWNED. `agentic-sdlc install-gates` writes it; `--force` overwrites
# it. Edit the source under src/agentic_sdlc/repo/installables/ and re-install
# — a local edit here is a fork by copy, and it is invisible, because the file
# still looks like the one that was installed.
#
# YOUR Makefile is two lines plus whatever is yours:
#
#     DEVKIT_VERSION := v0.20.0
#     include Makefile.devkit
#
#     my-scan: ## a gate of your own
#     	@bash tools/dev/checks/my_scan.sh
#
# and your own gates join `check` through devkit.toml rather than through a
# fork of this file:
#
#     [gates]
#     extra = ["my-scan"]
#
# THE MIDDLE TIER IS NOT IN HERE. `precommit` and `milestone` are `check` plus
# whatever tiers a LANGUAGE KIT declared, and this file names none of them. The
# kit writes one file — GDK_TIERS_MK, default `Makefile.tiers` — which DEFINES
# its targets and DECLARES which compositions they join:
#
#     GDK_PRECOMMIT_TIERS := parse lint unit
#     GDK_MILESTONE_TIERS := parse lint warnings unit integration-all
#
#     .PHONY: parse lint warnings unit integration-all
#     parse: ## Compile gate — every source file compiles
#     	@bash tools/dev/runners/parse.sh
#
# THE TIER FILE DECLARES ITS OWN `.PHONY`. The `.PHONY` below can only list
# what THIS file defines — a target it never heard of cannot be on it — and a
# tier target that is not phony is a gate that a stray file of the same name
# silently disables. One `.PHONY` line per file, each covering its own.
#
# `-include` of a missing tier file is SILENT, which is what makes a project
# with no tiers at all a supported shape rather than a degraded one. It is also
# how a typo'd GDK_TIERS_MK would turn a five-gate `precommit` into a one-gate
# `precommit` that exits 0. So the two cases are held apart on exactly one
# condition — whether a tier list is empty:
#
#   * an EMPTY tier list is fine, and SAYS SO on every run. A short gate that
#     looks like a long one is the one failure a gate must never have;
#   * a NAMED tier that resolves to no make target is a PARSE-TIME error that
#     names the variable that named it — before `check` runs, not after.
#
# Tier names are NOT validated as strings the way `[gates] extra` is. That
# refusal matrix exists because `[gates] extra` comes out of TOML a stranger
# supplied; these are make goals in a make file the project's own kit wrote,
# already parsed by make itself. The asymmetry is deliberate.
#
# EVERY GATE PRINTS ONE LINE. The default output of a gate target is its
# verdict, naming the full transcript on disk; `VERBOSE=1` streams the whole
# thing. That is `gdk_gate_capture` / `gdk_gate_verdict` out of
# tools/dev/gdk_gate.sh — either called by the recipe here, or already
# called INSIDE the runner it invokes. A tier target whose runner publishes its
# own verdict must NOT be wrapped again: the wrapper's summary would replace it
# and file the real one away in a log nobody opens.
#
# GNU make 3.81 (what macOS ships) is the floor. Nothing here needs more.
#
# NO `.SHELLFLAGS := -eu -o pipefail -c`. The gate recipes SOURCE the runner
# library, and the library's capture helper has to suspend and restore errexit
# to read PIPESTATUS at all; running it under an inherited `-e` is the case its
# own comments record dying on. Recipes here are written to be robust without
# it — explicit `|| exit`, and the helper's exit code read from a variable.
SHELL := bash
MAKEFLAGS += --warn-undefined-variables --no-print-directory
.DELETE_ON_ERROR:
.DEFAULT_GOAL := help

# The one line that MUST differ per project: the devkit tag every machine and
# every CI run resolves. It is yours, it lives in YOUR Makefile, and it is set
# BEFORE this include.
ifndef DEVKIT_VERSION
$(error DEVKIT_VERSION is not set — put `DEVKIT_VERSION := vX.Y.Z` in your Makefile ABOVE `include Makefile.devkit`)
endif
DEVKIT ?= uvx --from "git+https://github.com/cdowin/agentic-sdlc@$(DEVKIT_VERSION)" agentic-sdlc

# Where `install-gates` put the shell library this file sources. Moving it means
# setting this; after the write the file is yours. A language kit's own runners
# live wherever its tier file says — that is not this file's business.
GDK_DEV_DIR  ?= tools/dev
# The shell library every gate recipe sources. `install-gates` writes it
# beside this file; it is the other half of the same verb and neither is
# usable alone.
GDK_GATE_LIB ?= $(GDK_DEV_DIR)/gdk_gate.sh

# Gate output is a SUMMARY by default; the transcript goes to
# .gate-reports/<gate>.log, which the verdict line names. Exported so
# `make check VERBOSE=1` works as well as `VERBOSE=1 make check` — a
# command-line make variable is not in a recipe's environment otherwise.
VERBOSE ?=
export VERBOSE

# How the gate library reaches the ledger. `gdk_gate.sh` is SOURCED, so it
# cannot see a make variable at all — this one line is the whole bridge, and
# every gate's cost row rides over it. Empty it (`make check GDK_LEDGER_CMD=`)
# and nothing is recorded and nothing is spawned.
export GDK_LEDGER_CMD ?= $(DEVKIT)

# Arguments, overridden on the command line:
#   ARGS — passthrough              make pm ARGS="story building <id>"
ARGS ?=

# Set by `check` when it re-enters itself through a sub-make. See `check`.
GDK_IN_CHECK ?=

# What a FAILING gate shows on the console before its verdict: the lines that
# say what broke. Everything else stays in the log.
GDK_GATE_FAIL_RE    ?= ^(FAILED|ERROR|SCRIPT ERROR)|  DRIFT |\] FAIL|^  (MISS|FALSE POSITIVE)
GDK_GATE_FAIL_LINES ?= 20

# Each gate's one-line summary, read back out of its own transcript. The
# leading `[tag]` a tool prints is stripped: the verdict line supplies the tag.
# Both are part of the framework's surface — a tier file calls `gdk_gate` with
# one of these, or with a summary command of its own.
GDK_SUM_CHECKS := printf '%s check(s) PASS' "$$(grep -acE '^\[check:[a-z-]+\] PASS' "$$log")"
# The last line the tool TAGGED, not simply the last line: a runner whose
# closing word is a pointer ("  full report: …") would otherwise summarise
# itself as a file path. Falls back to the real last line when nothing in the
# transcript is tagged at all, because a summary that is blank says less than
# a wrong one.
GDK_SUM_TAIL   := { grep -aE '^\[[A-Za-z][A-Za-z:_-]*\] ' "$$log" || tail -1 "$$log"; } \
                  | tail -1 | sed -E 's/^\[[a-zA-Z:_-]+\] //'

# $(call gdk_gate,<log slot>,<TAG>,<summary command>,<argv...>)
# Run a command through the shipped capture helper: quiet by default, the full
# transcript on disk, one verdict line naming it, and the command's own exit
# code preserved (the helper reads PIPESTATUS, so `$$?` would be the cap's).
define gdk_gate
@set -o pipefail; . $(GDK_GATE_LIB); \
log="$$(gdk_gate_log $(1))"; \
gdk_gate_capture "$$log" -- $(4); \
status="$$GDK_GATE_EXIT"; \
summary="$$($(3))"; \
if [ "$$status" -ne 0 ]; then \
	grep -aE '$(GDK_GATE_FAIL_RE)' "$$log" | head -$(GDK_GATE_FAIL_LINES) \
		|| tail -$(GDK_GATE_FAIL_LINES) "$$log"; \
	summary="FAIL (exit $$status) — $$summary"; \
fi; \
gdk_gate_verdict $(2) "$$summary" "$$log"; \
exit "$$status"
endef

# ONLY what this file defines. The tier file declares its own — see the header.
.PHONY: help pm check precommit milestone \
        gdk-tiers-none-precommit gdk-tiers-none-milestone

help: ## Show this help (authoritative target list)
	@echo "make <target> — the gate framework from Makefile.devkit, plus this project's tiers and its own"
	@echo
	@{ grep -hE '^[a-zA-Z0-9_-]+:.*?## .*$$' $(MAKEFILE_LIST) || true; } \
		| sort -u \
		| awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-18s\033[0m %s\n", $$1, $$2}'
	@echo
	@echo 'Args: ARGS="…"  VERBOSE=1     Tiers: $(GDK_TIERS_MK) -> precommit=[$(strip $(GDK_PRECOMMIT_TIERS))] milestone=[$(strip $(GDK_MILESTONE_TIERS))]'
	@echo 'Gates print ONE verdict line naming .gate-reports/<gate>.log; VERBOSE=1 streams it.'

pm: ## PM-tree CLI (the ONLY sanctioned status transition):  make pm ARGS="story building <id>"
	@$(DEVKIT) pm $(if $(ARGS),$(ARGS),--help)

# --- Aggregate gates ----------------------------------------------------------
# `check` is the devkit gate roster (`check all`, whose members are `[checks]
# all` in devkit.toml) followed by THIS project's own gate targets (`[gates]
# extra`). Extension by config; no fork of this file, and no second list of
# gate names anywhere.
#
# The roster is read ONCE per run, by the devkit CLI, because make has no
# business parsing TOML — a `sed` over section headers is a second reader and
# a second answer. A bad value exits 2 here rather than silently narrowing the
# gate, which is the one failure mode a gate must never have.
#
# RE-ENTRY IS REFUSED. `extra = ["check"]` — or a project gate that itself runs
# `make check` — would recurse forever. The sub-make carries a marker, and a
# second entry stops with a line naming the config key. That holds for
# `precommit` and `milestone` too, and for a target two levels down, which a
# list of forbidden names could not.
#
# THE SUB-MAKE IS SPELLED `$${MAKE:-make}`, NOT `$(MAKE)`, ON PURPOSE. Make
# executes any recipe line containing the literal `$(MAKE)` even under `-n` —
# so `make -n check`, which promises to run NOTHING, would fetch and run the
# pinned package to read the roster. The cost is that `make -j check` starts
# the sub-make without the jobserver; gates are sequential anyway, and a
# dry run that quietly executes is the worse of the two.
check: ## Static gate: the devkit checks + this project's own ([gates] extra)
	@test -z "$(GDK_IN_CHECK)" || { echo "make check: re-entered through [gates] extra in devkit.toml — a gate target that runs \`make check\` recurses forever; drop it from that list" >&2; exit 2; }
	$(call gdk_gate,check,CHECK,$(GDK_SUM_CHECKS),$(DEVKIT) check all)
	@extra="$$($(DEVKIT) gates-extra)" || exit $$?; \
	[ -z "$$extra" ] || $${MAKE:-make} GDK_IN_CHECK=1 $$extra

# --- The tier seam ------------------------------------------------------------
# The language kit's contribution, resolved at PARSE time. No sub-make, no
# runtime cost, and prerequisites stay prerequisites — so `make -n precommit`
# keeps its promise to run nothing while still listing everything.
GDK_TIERS_MK        ?= Makefile.tiers
GDK_PRECOMMIT_TIERS ?=
GDK_MILESTONE_TIERS ?=
-include $(GDK_TIERS_MK)

# The typo guard. `-include` is silent on a missing file and that silence is
# load-bearing (no tiers is a supported shape), so the guard turns on the
# moment a tier list is NON-EMPTY and stays off otherwise. Two shapes fail:
# a tier list with no tier file to have come from, and a tier name no makefile
# read so far actually defines.
GDK_TIERS_DECLARED := $(strip $(GDK_PRECOMMIT_TIERS) $(GDK_MILESTONE_TIERS))
ifneq (,$(GDK_TIERS_DECLARED))
ifeq (,$(wildcard $(GDK_TIERS_MK)))
$(error GDK_TIERS_MK=$(GDK_TIERS_MK) does not exist yet a tier list names [$(GDK_TIERS_DECLARED)] — `-include` of a missing file is silent by design and this is the typo that silence hides. Point GDK_TIERS_MK at the tier file or clear GDK_PRECOMMIT_TIERS / GDK_MILESTONE_TIERS)
endif
# Every explicit target name in the makefiles read so far. Read from the FILES
# rather than from make's tables because 3.81 exposes no target introspection;
# a tier defined only by a pattern rule is therefore not visible here and must
# be given an explicit target in the tier file.
GDK_TIERS_TARGETS := $(shell awk '/^[A-Za-z0-9][A-Za-z0-9._\/-]*[ \t]*:([^=]|$$)/ { sub(/[ \t]*:.*/, ""); print }' $(MAKEFILE_LIST))
GDK_TIERS_ORPHAN_PRECOMMIT := $(filter-out $(GDK_TIERS_TARGETS),$(GDK_PRECOMMIT_TIERS))
GDK_TIERS_ORPHAN_MILESTONE := $(filter-out $(GDK_TIERS_TARGETS),$(GDK_MILESTONE_TIERS))
ifneq (,$(GDK_TIERS_ORPHAN_PRECOMMIT))
$(error GDK_PRECOMMIT_TIERS names a tier no makefile defines: [$(GDK_TIERS_ORPHAN_PRECOMMIT)] — declared for $(GDK_TIERS_MK); a gate list that quietly gets shorter is the one failure a gate must never have)
endif
ifneq (,$(GDK_TIERS_ORPHAN_MILESTONE))
$(error GDK_MILESTONE_TIERS names a tier no makefile defines: [$(GDK_TIERS_ORPHAN_MILESTONE)] — declared for $(GDK_TIERS_MK); a gate list that quietly gets shorter is the one failure a gate must never have)
endif
endif

# The empty case ANNOUNCES ITSELF. It is legitimate — a project with no
# language kit gates on `check` alone — but it is one gate where a tiered
# project runs five, and an operator who cannot tell the two runs apart from
# the output has been handed the cardinal sin in a Makefile. It is a
# PREREQUISITE, not a recipe: the compositions themselves still print nothing
# of their own, and it runs FIRST, before the gate it is describing.
define gdk_tiers_none
@echo "[TIERS] $(1) is empty — this gate is \`check\` alone; $(GDK_TIERS_MK) $(if $(wildcard $(GDK_TIERS_MK)),declares no tier for it,is not present)"
endef

gdk-tiers-none-precommit:
	$(call gdk_tiers_none,GDK_PRECOMMIT_TIERS)

gdk-tiers-none-milestone:
	$(call gdk_tiers_none,GDK_MILESTONE_TIERS)

# The per-change gate and the full gate, and the compositions print nothing of
# their own: each member's verdict is the output.
precommit: $(if $(GDK_PRECOMMIT_TIERS),,gdk-tiers-none-precommit) check $(GDK_PRECOMMIT_TIERS) ## Per-change gate: check + GDK_PRECOMMIT_TIERS

milestone: $(if $(GDK_MILESTONE_TIERS),,gdk-tiers-none-milestone) check $(GDK_MILESTONE_TIERS) ## Full gate: check + GDK_MILESTONE_TIERS
