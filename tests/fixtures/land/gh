#!/bin/sh
# Stub gh for tests/land.sh. PRs number from 7 up; their state lives in $WL_FX:
#   pr-N holds the args of the PR (also copied to pr), merged-N marks it merged, auto-N auto-merge.
#   api repos/o/r/pulls -f head=H ...  opens a PR, prints N, then runs $WL_FX/on-open if it exists
#   api repos/o/r/pulls?head=o:H...    prints the open PR of head H, if any
#   pr merge N --auto ...              exits 1 when $WL_FX/noauto exists; else sets auto-merge
#   api -X PUT .../pulls/N/merge       merges (the fallback of wait-ci --merge); update-branch fails
#   $WL_FX/slow (once)                 makes the next pr view sleep 3 s
#   $WL_FX/late                        makes the merge call fail once; the PR then reads MERGED 2 views later
#   api repos/o/r/compare/...          prints how far the head is behind main
#   pr view N ... -q expr              prints expr on the PR. Checks: ci SUCCESS, and lint FAILURE
#                                      when $WL_FX/red-H exists. BEHIND when main is not in H.
#                                      Auto-merge fires here when the PR is green and not behind.
# A merge moves main to the PR head in the bare repo $WL_REMOTE (a fast-forward).
head() { sed -n 's/^head=//p' "$WL_FX/pr-$1"; }
merge() { git -C "$WL_REMOTE" update-ref refs/heads/main "refs/heads/$(head "$1")" && touch "$WL_FX/merged-$1"; }
behind() { git -C "$WL_REMOTE" rev-list --count "refs/heads/$(head "$1")..refs/heads/main"; }
case "$1 $2" in
  'pr merge') [ -f "$WL_FX/noauto" ] && exit 1; touch "$WL_FX/auto-$3" ;;
  'pr view')
    n=$3
    [ ! -f "$WL_FX/slow" ] || { rm -f "$WL_FX/slow"; sleep 3; }
    while [ "$#" -gt 1 ]; do [ "$1" = -q ] && q=$2; shift; done
    h=$(head "$n") mss=CLEAN checks='{"name":"ci","conclusion":"SUCCESS"}'
    [ "$(behind "$n")" = 0 ] || mss=BEHIND
    if [ -f "$WL_FX/red-$h" ]; then checks="$checks,{\"name\":\"lint\",\"conclusion\":\"FAILURE\"}"
    elif [ -f "$WL_FX/auto-$n" ] && [ "$mss" = CLEAN ]; then
      d=$(cat "$WL_FX/delay-$n" 2> /dev/null || echo 0)
      if [ "$d" -gt 0 ]; then echo $((d - 1)) > "$WL_FX/delay-$n"; else merge "$n"; fi
    fi
    if [ -f "$WL_FX/merged-$n" ]; then echo "{\"state\":\"MERGED\",\"statusCheckRollup\":[$checks]}"
    else echo "{\"state\":\"OPEN\",\"mergeable\":\"MERGEABLE\",\"mergeStateStatus\":\"$mss\",\"headRefOid\":\"$h\",\"baseRefName\":\"main\",\"statusCheckRollup\":[$checks]}"
    fi | jq -r "$q" ;;
  'api -X') case $4 in
    */merge) n=${4%/merge} n=${n##*/}
      if [ -f "$WL_FX/late" ]; then rm "$WL_FX/late"; echo 2 > "$WL_FX/delay-$n"; touch "$WL_FX/auto-$n"; exit 1; fi
      merge "$n" ;;
    *) exit 1 ;; esac ;;
  'api repos/o/r/pulls')
    # shellcheck disable=SC2010  # counts fixture names, plain names
    n=$(($(ls "$WL_FX" | grep -c '^pr-') + 7))
    printf '%s\n' "$@" > "$WL_FX/pr-$n" && cp "$WL_FX/pr-$n" "$WL_FX/pr" && echo "$n"
    [ ! -f "$WL_FX/on-open" ] || sh "$WL_FX/on-open" ;;
  'api repos/o/r/pulls?head='*)
    h=${2#*head=o:} h=${h%%&*}
    for f in "$WL_FX"/pr-*; do n=${f##*-}; [ -f "$f" ] && [ "$(head "$n")" = "$h" ] && [ ! -f "$WL_FX/merged-$n" ] && echo "$n"; done ;;
  'api repos/o/r/compare'*) h=${2##*...}; git -C "$WL_REMOTE" rev-list --count "refs/heads/$h..refs/heads/main" ;;
  *) echo "stub gh: $*" >&2; exit 1 ;;
esac
exit 0
